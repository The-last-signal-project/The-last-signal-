#!/bin/sh
set -eu

PHASE="${1:-}"

# Agir uniquement après validation de la transaction Git.
if [ "$PHASE" != "committed" ]; then
    exit 0
fi

REF_DIR=$(git rev-parse --git-path commit-validation/references)

while read -r OLD_SHA NEW_SHA REF; do

    # Ne traiter que les créations de branches locales.
    case "$REF" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # Une création possède un ancien SHA composé uniquement de zéros.
    case "$OLD_SHA" in
        *[!0]*) continue ;;
    esac

    BRANCH="${REF#refs/heads/}"
    REF_FILE="$REF_DIR/$BRANCH"


    git cat-file -e "$NEW_SHA^{commit}"

    mkdir -p "$(dirname "$REF_FILE")"

    TEMP_FILE="$REF_FILE.tmp.$$"
    trap 'rm -f "$TEMP_FILE"' EXIT HUP INT TERM

    printf '%s\n' "$NEW_SHA" > "$TEMP_FILE"
    mv "$TEMP_FILE" "$REF_FILE"

    echo "Référence créée pour $BRANCH : $NEW_SHA"

done

exit 0
