#!/bin/sh
set -eu

PHASE="${1:-}"

# Agir uniquement après validation de la transaction Git.
[ "$PHASE" = "committed" ] || exit 0

REF_DIR=$(git rev-parse --git-path commit-validation/references)

while IFS=' ' read -r OLD_SHA NEW_SHA REF; do

    # Ne traiter que les branches locales.
    case "$REF" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # Une création doit avoir un ancien SHA nul.
    case "$OLD_SHA" in
        *[!0]*) continue ;;
    esac

    # Une suppression possède un nouveau SHA nul.
    # Ne jamais tenter de lire ce SHA comme un commit.
    case "$NEW_SHA" in
        *[!0]*) ;;
        *) continue ;;
    esac

    BRANCH="${REF#refs/heads/}"
    REF_FILE="$REF_DIR/$BRANCH"

    # Vérifier que le nouveau SHA désigne bien un commit.
    if ! git cat-file -e "${NEW_SHA}^{commit}" 2>/dev/null; then
        echo "Erreur : commit introuvable pour $BRANCH" >&2
        exit 1
    fi

    mkdir -p "$(dirname "$REF_FILE")"

    TEMP_FILE="$REF_FILE.tmp.$$"
    trap 'rm -f "$TEMP_FILE"' EXIT HUP INT TERM

    printf '%s\n' "$NEW_SHA" > "$TEMP_FILE"
    mv "$TEMP_FILE" "$REF_FILE"

    echo "Référence créée pour $BRANCH : $NEW_SHA" >&2

done


exit 0
